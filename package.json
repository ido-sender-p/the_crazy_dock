{
  "name": "wildock",
  "version": "0.1.0",
  "description": "Wildock: a programmatic SEO catalogue of docks, piers and marinas worldwide, built on Hono and Cloudflare Workers",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create wildock-db",
    "db:migrate:local": "wrangler d1 execute wildock-db --local --file=./src/db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute wildock-db --remote --file=./src/db/schema.sql",
    "typecheck": "tsc --noEmit",
    "catalogue:import": "node scripts/import-wikidata.mjs",
    "catalogue:build": "node scripts/build-catalogue.mjs",
    "catalogue:images": "node scripts/load-images.mjs",
    "catalogue:variants": "node scripts/make-variants.mjs",
    "catalogue:nearby": "node scripts/enrich-nearby.mjs",
    "catalogue:all": "node scripts/build-catalogue.mjs && node scripts/build-about.mjs && node scripts/make-variants.mjs",
    "ship-photos": "node scripts/ship-photos.mjs",
    "r2:plan": "node scripts/r2-sync.mjs",
    "r2:upload": "node scripts/r2-sync.mjs --go",
    "verify:live": "node scripts/verify-live.mjs",
    "check": "node scripts/check.mjs"
  },
  "license": "ISC",
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.127.1"
  }
}
